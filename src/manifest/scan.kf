// A kf.toml or lint.toml read line by line, as far as an editor needs: the
// table each `key = value` row sits in, and where the cursor is.

import alloc.list.*

/// A kf.toml or lint.toml, and its rows.
pub struct Manifest {
    pub val text: String
    pub val rows: List<ManifestRow>
}

impl Manifest {
    /// Every row of `text`, in order. A value that spans lines is read to the
    /// end of its first.
    pub static fun parse(text: str): Manifest {
        var rows = List.new<ManifestRow>()
        var table = String.from("")
        var start: uint64 = 0
        while start <= text.byte_len() {
            val end = line_end(text, start)
            val line = text.substring(start, end)
            val header = table_name(line.as_str())
            if header.is_some() {
                table = header ?: String.from("")
            } else {
                val equals = unquoted_index(line.as_str(), 61) ?: -1
                if equals > 0 {
                    val key_start = start + leading_spaces(line.as_str())
                    val key_end = start + trimmed_end(line.as_str(), equals as uint64)
                    val after = line.substring(equals as uint64 + 1, line.byte_len())
                    val value_start = start + equals as uint64 + 1 + leading_spaces(after.as_str())
                    val comment = unquoted_index(line.as_str(), 35) ?: line.byte_len() as int64
                    val value_end = start + trimmed_end(line.as_str(), comment as uint64)
                    if key_end > key_start && !line.as_str().trim().starts_with("#") {
                        rows.push(ManifestRow {
                            table: table.clone(), key: text.substring(key_start, key_end).as_str().unquoted(),
                            key_start: key_start, key_end: key_end, value_start: value_start,
                            value_end: if value_end > value_start { value_end } else { value_start }
                        })
                    }
                }
            }
            start = end + 1
        }
        return Manifest { text: String.from(text), rows: rows }
    }

    /// What is being written at byte `offset`.
    pub fun spot_at(offset: uint64): ManifestSpot {
        val text = self.text.as_str()
        val at = if offset < text.byte_len() { offset } else { text.byte_len() }
        val line_start = line_start_of(text, at)
        var table = String.from("")
        var start: uint64 = 0
        while start < line_start {
            val header = table_name(text.substring(start, line_end(text, start)).as_str())
            if header.is_some() { table = header ?: String.from("") }
            start = line_end(text, start) + 1
        }
        val prefix = text.substring(line_start, at)
        val word = line_start + word_start(prefix.as_str())
        val quoted = word > line_start && text.byte(word - 1) == 34
        if prefix.as_str().trim_start().starts_with("[") {
            return spot(table, SpotKind.Table, "", "", false, word, false)
        }
        val equals = unquoted_index(prefix.as_str(), 61) ?: -1
        if equals < 0 { return spot(table, SpotKind.Key, "", "", false, word, false) }
        val key = prefix.substring(0, equals as uint64).as_str().trim().as_str().unquoted()
        val rest = prefix.substring(equals as uint64 + 1, prefix.byte_len())
        val brace = unquoted_index(rest.as_str(), 123) ?: -1
        if brace < 0 { return spot(table, SpotKind.Value, key.as_str(), "", false, word, quoted) }
        val inner = rest.substring(brace as uint64 + 1, rest.byte_len())
        val comma = unquoted_last_index(inner.as_str(), 44) ?: -1
        val member = inner.substring((comma + 1) as uint64, inner.byte_len())
        val inner_equals = unquoted_index(member.as_str(), 61) ?: -1
        val inner_key = if inner_equals < 0 {
            String.from("")
        } else {
            member.substring(0, inner_equals as uint64).as_str().trim().as_str().unquoted()
        }
        return spot(table, SpotKind.Value, key.as_str(), inner_key.as_str(), true, word, quoted)
    }

    /// The row whose key or value holds byte `offset`.
    pub fun row_at(offset: uint64): ManifestRow? {
        var found: ManifestRow? = null
        while row in &self.rows {
            if row.key_start <= offset && offset <= row.value_end { found = Option.Some(row.clone()) }
        }
        return found
    }

    /// A row's value as written.
    pub fun value_of(row: &ManifestRow): String {
        return self.text.substring(row.value_start, row.value_end)
    }

    /// The URL of the index a row names with `index = "..."`, from
    /// `[indexes]`; "" for the default index.
    pub fun index_url_for(table: str, key: str): String {
        var name = String.from("")
        while row in &self.rows {
            if row.table.as_str() == table && row.key.as_str() == key {
                name = self.value_of(row).as_str().inline_value("index")
            }
        }
        if name.is_empty() { return name }
        while row in &self.rows {
            if row.table.as_str() == "indexes" && row.key.as_str() == name.as_str() {
                return self.value_of(row).as_str().unquoted()
            }
        }
        return String.from("")
    }
}

/// One `key = value` row, as byte offsets into the text. The value runs to
/// the end of its line, a trailing comment left out.
@derive(Clone)
pub struct ManifestRow {
    pub val table: String
    pub val key: String
    pub val key_start: uint64
    pub val key_end: uint64
    pub val value_start: uint64
    pub val value_end: uint64
}

/// What the cursor is writing.
@derive(Copy, Equal)
pub enum SpotKind {
    /// A table's name, after `[`.
    Table
    /// A row's key.
    Key
    /// A row's value, or a key or value inside its inline table.
    Value
}

pub struct ManifestSpot {
    pub val table: String
    pub val kind: SpotKind
    /// The row's key, for a value.
    pub val key: String
    /// Inside `{ ... }`: the inner key whose value the cursor is in, or ""
    /// when it is writing an inner key.
    pub val inner_key: String
    pub val in_braces: bool
    /// Where the word being written starts; it ends at the cursor.
    pub val start: uint64
    /// The word is inside quotes that are already written.
    pub val quoted: bool
}

fun spot(table: String, kind: SpotKind, key: str, inner_key: str, in_braces: bool, start: uint64,
         quoted: bool): ManifestSpot {
    return ManifestSpot {
        table: table, kind: kind, key: String.from(key), inner_key: String.from(inner_key), in_braces: in_braces,
        start: start, quoted: quoted
    }
}

/// The value of `inner` in an inline table `{ a = "x", inner = "y" }`, its
/// quotes taken off; "" when it has none.
fun str.inline_value(inner: str): String {
    val value = self
    if !value.trim_start().starts_with("{") { return String.from("") }
    val body: str = value.trim_start()
    var rest = body.substring(1, body.byte_len())
    while true {
        val comma = unquoted_index(rest.as_str(), 44) ?: rest.byte_len() as int64
        val member = rest.substring(0, comma as uint64)
        val equals = unquoted_index(member.as_str(), 61) ?: -1
        if equals > 0 && member.substring(0, equals as uint64).as_str().trim().as_str().unquoted().as_str() == inner {
            return member.substring(equals as uint64 + 1, member.byte_len()).as_str().unquoted()
        }
        if comma as uint64 >= rest.byte_len() { break }
        rest = rest.substring(comma as uint64 + 1, rest.byte_len())
    }
    return String.from("")
}

/// A value's text with its quotes, and an inline table's closing brace,
/// taken off.
fun str.unquoted(): String {
    val trimmed: str = self.trim()
    var text = String.from(trimmed)
    if text.as_str().ends_with("}") {
        val inner: str = text.substring(0, text.byte_len() - 1).as_str().trim()
        text = String.from(inner)
    }
    if text.byte_len() < 2 { return text }
    val quote = text.byte(0)
    if (quote == 34 || quote == 39) && text.byte(text.byte_len() - 1) == quote {
        return text.substring(1, text.byte_len() - 1)
    }
    return text
}

/// `name` for a `[name]` or `[[name]]` line.
fun table_name(line: str): String? {
    val trimmed = line.trim()
    if !trimmed.starts_with("[") { return null }
    val close = trimmed.index_of("]") ?: return null
    var name = trimmed.substring(1, close)
    if name.as_str().starts_with("[") { name = name.substring(1, name.byte_len()) }
    val bare: str = name.as_str().trim()
    return Option.Some(String.from(bare))
}

fun line_end(text: str, start: uint64): uint64 {
    var at = start
    while at < text.byte_len() && text.byte(at) != 10 { at = at + 1 }
    return at
}

fun line_start_of(text: str, offset: uint64): uint64 {
    var at = offset
    while at > 0 && text.byte(at - 1) != 10 { at = at - 1 }
    return at
}

fun leading_spaces(text: str): uint64 {
    var at: uint64 = 0
    while at < text.byte_len() && (text.byte(at) == 32 || text.byte(at) == 9) { at = at + 1 }
    return at
}

/// The end of `text`'s first `end` bytes with trailing blanks dropped.
fun trimmed_end(text: str, end: uint64): uint64 {
    var at = end
    while at > 0 && (text.byte(at - 1) == 32 || text.byte(at - 1) == 9 || text.byte(at - 1) == 13) { at = at - 1 }
    return at
}

/// Where the word ending at the end of `prefix` starts: after the last
/// blank, quote, bracket, brace, comma or `=`.
fun word_start(prefix: str): uint64 {
    var at = prefix.byte_len()
    while at > 0 {
        val byte = prefix.byte(at - 1)
        val stops = byte == 32 || byte == 9 || byte == 34 || byte == 39 || byte == 91 || byte == 123 ||
            byte == 44 || byte == 61
        if stops { return at }
        at = at - 1
    }
    return 0
}

/// The first `byte` of `text` outside quotes.
fun unquoted_index(text: str, byte: uint8): int64? {
    var quote: uint8 = 0
    while i in 0..text.byte_len() {
        val here = text.byte(i)
        if quote != 0 {
            if here == quote { quote = 0 }
        } else if here == 34 || here == 39 {
            quote = here
        } else if here == byte {
            return Option.Some(i as int64)
        }
    }
    return null
}

/// The last `byte` of `text` outside quotes.
fun unquoted_last_index(text: str, byte: uint8): int64? {
    var quote: uint8 = 0
    var found: int64? = null
    while i in 0..text.byte_len() {
        val here = text.byte(i)
        if quote != 0 {
            if here == quote { quote = 0 }
        } else if here == 34 || here == 39 {
            quote = here
        } else if here == byte {
            found = Option.Some(i as int64)
        }
    }
    return found
}
