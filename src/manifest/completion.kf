// Completion in kf.toml and lint.toml: tables, keys, packages and their
// versions, toolchains, and lints with their levels and options.

import alloc.list.*
import json.writer.*
import komp_lsp.komp.*
import komp_lsp.protocol.*

@derive(Clone)
struct Candidate {
    val label: String
    val detail: String
    val documentation: String
    /// LSP's completion kind.
    val kind: int64
    /// What replaces the word being written.
    val insert: String
}

/// `textDocument/completion`'s result at byte `offset` of a manifest, in
/// the order the candidates are offered.
mutating fun ManifestService.completion(path: str, manifest: &Manifest, view: &TextView, offset: uint64): String {
    val at = manifest.spot_at(offset)
    val candidates = self.candidates(path, manifest, &at)
    var writer = JsonWriter.object()
    writer.field_bool("isIncomplete", false)
    writer.key("items")
    writer.begin_array()
    while i in 0..candidates.size() {
        val item = candidates[i].clone()
        writer.begin_object()
        writer.field_string("label", item.label.as_str())
        writer.field_int64("kind", item.kind)
        if !item.detail.is_empty() { writer.field_string("detail", item.detail.as_str()) }
        if !item.documentation.is_empty() {
            writer.field_raw("documentation", markdown_json(item.documentation.as_str()).as_str())
        }
        writer.field_string("sortText", sort_key(i).as_str())
        writer.field_string("filterText", item.label.as_str())
        writer.key("textEdit")
        writer.begin_object()
        writer.key("range")
        writer.write_range(view, at.start, offset)
        writer.field_string("newText", item.insert.as_str())
        writer.end_object()
        writer.end_object()
    }
    writer.end_array()
    return writer.finish()
}

mutating fun ManifestService.candidates(path: str, manifest: &Manifest, at: &ManifestSpot): List<Candidate> {
    val lint_file = path.ends_with("/lint.toml")
    if at.kind == SpotKind.Table {
        if lint_file { return words("groups lints", "table", 9, false) }
        return words("project dependencies tools indexes workspace native lint", "table", 9, false)
    }
    if lint_file || at.table.as_str() == "lint" { return self.lint_candidates(path.parent_dir().as_str(), at) }
    if at.table.as_str() == "dependencies" { return self.package_candidates(manifest, at, true) }
    if at.table.as_str() == "tools" { return self.package_candidates(manifest, at, false) }
    if at.table.as_str() == "project" { return self.project_candidates(at) }
    return List.new<Candidate>()
}

mutating fun ManifestService.project_candidates(at: &ManifestSpot): List<Candidate> {
    if at.kind == SpotKind.Key { return words("name version kind description kflat freestanding", "", 10, false) }
    if at.key.as_str() == "kind" { return words("bin lib", "", 20, !at.quoted) }
    if at.key.as_str() != "kflat" { return List.new<Candidate>() }
    val toolchains = self.komp.toolchains()
    var out = List.new<Candidate>()
    while i in 0..toolchains.size() {
        val detail = if i == 0 { "this komp" } else { "installed" }
        out.push(value(toolchains[i].as_str(), detail, "", !at.quoted))
    }
    return out
}

/// A dependency's or a tool's name, the keys of its inline table, its index,
/// or its version: newest first, yanked ones left out, each marked when the
/// cache holds it.
mutating fun ManifestService.package_candidates(manifest: &Manifest, at: &ManifestSpot,
                                                dependency: bool): List<Candidate> {
    var out = List.new<Candidate>()
    if at.kind == SpotKind.Key {
        val catalog = self.komp.catalog()
        while package in &catalog {
            out.push(Candidate {
                label: package.name.clone(), detail: package.newest.clone(),
                documentation: package.description.clone(), kind: 9, insert: package.name.clone()
            })
        }
        return out
    }
    if at.in_braces && at.inner_key.is_empty() {
        if dependency { return words("version index path git tag rev branch tarball checksum", "", 10, false) }
        return words("version index", "", 10, false)
    }
    if at.in_braces && at.inner_key.as_str() == "index" {
        while row in &manifest.rows {
            if row.table.as_str() == "indexes" { out.push(value(row.key.as_str(), "index", "", !at.quoted)) }
        }
        return out
    }
    if at.in_braces && at.inner_key.as_str() != "version" { return out }
    val index = manifest.index_url_for(at.table.as_str(), at.key.as_str())
    val versions = self.komp.versions(at.key.as_str(), index.as_str())
    val cached = self.komp.cached_sources()
    var newest = true
    var i = versions.size()
    while i > 0 {
        i = i - 1
        val version = versions[i].clone()
        if version.yanked { continue }
        val is_cached = cached.contains(&"${at.key}@${version.version}")
        var detail = String.from(if newest { "newest" } else { "" })
        if is_cached { detail = String.from(if newest { "newest, cached" } else { "cached" }) }
        out.push(value(version.version.as_str(), detail.as_str(), "", !at.quoted))
        newest = false
    }
    return out
}

/// Lint and group names, levels, and a lint's own options.
mutating fun ManifestService.lint_candidates(dir: str, at: &ManifestSpot): List<Candidate> {
    val facts = self.komp.lints(dir)
    var out = List.new<Candidate>()
    val groups_table = at.table.as_str() == "groups"
    if at.kind == SpotKind.Key && groups_table {
        while group in &facts.groups { out.push(value(group.as_str(), "group", "", false)) }
        out.push(value("all", "every lint", "", false))
        return out
    }
    if at.kind == SpotKind.Key {
        while lint in &facts.lints {
            out.push(Candidate {
                label: lint.name.clone(), detail: "${lint.group}, ${lint.level}",
                documentation: lint.markdown(), kind: 10, insert: lint.name.clone()
            })
        }
        return out
    }
    if at.in_braces && at.inner_key.is_empty() {
        out.push(value("level", "", "", false))
        val lint = facts.lint_named(at.key.as_str()) ?: return out
        while option in &lint.options {
            out.push(Candidate {
                label: option.key.clone(), detail: "default ${option.default_value}",
                documentation: option.description.clone(), kind: 10, insert: option.key.clone()
            })
        }
        return out
    }
    if at.in_braces && at.inner_key.as_str() != "level" { return out }
    return words("allow warn deny", "level", 20, !at.quoted)
}

/// A lint's description and options, as markdown.
fun LintFact.markdown(): String {
    var out = String.from(self.description.as_str())
    if self.default_level.as_str() != self.level.as_str() {
        out.append("\n\n${self.level} here; ${self.default_level} by default".as_str())
    }
    while option in &self.options {
        out.append("\n\n`${option.key} = ${option.value}`: ${option.description}".as_str())
    }
    return out
}

/// One candidate per space-separated word; `quote` wraps what is inserted
/// in double quotes.
fun words(list: str, detail: str, kind: int64, quote: bool): List<Candidate> {
    var out = List.new<Candidate>()
    while word in &list.split(" ") {
        val insert = if quote { "\"${word}\"" } else { word.clone() }
        out.push(Candidate {
            label: word.clone(), detail: String.from(detail), documentation: String.from(""), kind: kind,
            insert: insert
        })
    }
    return out
}

fun value(label: str, detail: str, documentation: str, quote: bool): Candidate {
    val insert = if quote { "\"${label}\"" } else { String.from(label) }
    return Candidate {
        label: String.from(label), detail: String.from(detail), documentation: String.from(documentation),
        kind: 12, insert: insert
    }
}

fun markdown_json(text: str): String {
    var writer = JsonWriter.object()
    writer.field_string("kind", "markdown")
    writer.field_string("value", text)
    return writer.finish()
}

/// Four digits, so clients sort the candidates in the order given.
fun sort_key(at: uint64): String {
    var out = "${at}"
    while out.byte_len() < 4 { out = "0${out}" }
    return out
}
