import core.assert.assert_eq

fun checked_with_a_fix(): String {
    return String.from("{\"id\":4,\"result\":{\"errors\":1,\"diagnostics\":[") +
        "{\"schema_version\":3,\"severity\":\"error\",\"code\":null,\"message\":\"no method\"," +
        "\"byte_start\":4,\"byte_end\":10,\"file\":\"/w/a.kf\",\"line\":2,\"column\":1,\"secondary\":[]," +
        "\"fix\":{\"title\":\"change to `sum`\",\"replacement\":\"sum\",\"applicability\":\"machine-applicable\"," +
        "\"byte_start\":6,\"byte_end\":10,\"file\":\"/w/a.kf\"}}]}}"
}

fun fixes_of(answer: str): List<Fix> {
    val texts = FixedText { text: String.from("abc\np.sunm()\n") }
    val files = diagnostics_by_file(answer, true, &texts) ?: return List.new<Fix>()
    if files.is_empty() { return List.new<Fix>() }
    return files[0].fixes.clone()
}

@test
fun a_fix_is_offered_on_its_diagnostic_line(): void {
    val fixes = fixes_of(checked_with_a_fix().as_str())
    val actions = lsp_code_actions(&fixes, "/w/a.kf", 1, 1)
    val expected = String.from("[{\"title\":\"change to `sum`\",\"kind\":\"quickfix\",\"diagnostics\":[") +
        "{\"range\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":6}},\"severity\":1," +
        "\"source\":\"kflatc\",\"message\":\"no method\"}],\"edit\":{\"changes\":{\"file:///w/a.kf\":[" +
        "{\"range\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":6}}," +
        "\"newText\":\"sum\"}]}}}]"
    assert_eq(actions.as_str(), expected.as_str(), "the repair, as a quick fix")
}

@test
fun a_fix_is_not_offered_on_another_line(): void {
    val fixes = fixes_of(checked_with_a_fix().as_str())
    assert_eq(lsp_code_actions(&fixes, "/w/a.kf", 0, 0).as_str(), "[]", "the first line has no problem")
}

@test
fun a_null_fix_offers_nothing(): void {
    val answer = String.from("{\"id\":4,\"result\":{\"errors\":1,\"diagnostics\":[") +
        "{\"schema_version\":3,\"severity\":\"error\",\"code\":null,\"message\":\"bad\"," +
        "\"byte_start\":4,\"byte_end\":6,\"file\":\"/w/a.kf\",\"line\":2,\"column\":1,\"secondary\":[],\"fix\":null}]}}"
    assert_eq(fixes_of(answer.as_str()).is_empty(), true, "no repair")
}
