@test
fun a_request_keeps_its_integer_id(): void {
    val message = parse_message("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\"}")
    assert_eq(message?.id ?: "", "3", "the id is its JSON text")
}

@test
fun a_request_keeps_its_string_id_quoted(): void {
    val message = parse_message("{\"id\":\"a\\\"b\",\"method\":\"shutdown\"}")
    assert_eq(message?.id ?: "", "\"a\\\"b\"", "the id is echoed as JSON")
}

@test
fun a_request_names_its_method(): void {
    val message = parse_message("{\"id\":1,\"method\":\"initialize\",\"params\":{\"a\":[1,2]}}")
    assert_eq(message?.method ?: "", "initialize", "params are passed over")
}

@test
fun a_notification_has_no_id(): void {
    val message = parse_message("{\"method\":\"initialized\",\"params\":{}}")
    assert_eq(message?.id.is_none(), true, "no id")
}

@test
fun text_that_is_not_an_object_is_no_message(): void {
    assert_eq(parse_message("[1]").is_none(), true, "an array is not a message")
}

@test
fun a_truncated_object_is_no_message(): void {
    assert_eq(parse_message("{\"id\":1,").is_none(), true, "truncated")
}
