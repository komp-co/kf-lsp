// The language server's state, and what each message from the editor does
// to it.

import alloc.list.*
import json.reader.*
import json.writer.*
import komp_lsp.manifest.*
import komp_lsp.protocol.*
import komp_lsp.source.*

/// Where the server is in its lifecycle; each allows different requests.
@derive(Copy, Equal)
pub enum Phase {
    Starting
    Running
    ShuttingDown
}

/// What one message produced: messages to send, and once the client says
/// `exit`, the code to exit with.
pub struct Outcome {
    pub var messages: List<String>
    pub var exit_code: int32?
}

pub struct Server {
    pub var phase: Phase
    var documents: Documents
    /// `.kf` files, answered by the compiler.
    var source: SourceService
    /// kf.toml and lint.toml, answered from what komp reports.
    var manifests: ManifestService
}

impl Server {
    /// `komp` is the command the server asks about the project.
    pub static fun new(komp: str): Server {
        return Server {
            phase: Phase.Starting, documents: Documents.new(), source: SourceService.new(komp),
            manifests: ManifestService.new(komp)
        }
    }

    pub mutating fun handle(body: str): Outcome {
        var messages = List.new<String>()
        val parsed = Message.parse(body)
        if parsed.is_none() {
            messages.push("null".error_reply(ErrorCode.ParseError, "not a JSON object"))
            return Outcome { messages: messages, exit_code: null }
        }
        val message = parsed ?: return Outcome { messages: messages, exit_code: null }
        val method = message.method?.clone() ?: String.from("")
        if method.as_str() == "exit" {
            val code: int32 = if self.phase == Phase.ShuttingDown { 0 } else { 1 }
            return Outcome { messages: messages, exit_code: Option.Some(code) }
        }
        if method.is_empty() { return Outcome { messages: messages, exit_code: null } }
        when (message.id) {
            Some(id) => {
                val reply = self.answer(id.as_str(), method.as_str(), body, &var messages)
                messages.push(reply)
            }
            None => self.notified(method.as_str(), body, &var messages)
        }
        return Outcome { messages: messages, exit_code: null }
    }

    /// How long until a check is due; `null` when none is waiting.
    pub fun wait_time(): Duration? {
        val checks = self.source.wait_time()
        val jobs = self.manifests.wait_time()
        if checks.is_none() { return jobs }
        if jobs.is_none() { return checks }
        val check_nanos = checks?.as_nanos() ?: 0
        val job_nanos = jobs?.as_nanos() ?: 0
        return if check_nanos < job_nanos { checks } else { jobs }
    }

    /// The messages that publish what the checks now due found, and what a
    /// finished komp job reported.
    pub mutating fun run_due_checks(): List<String> {
        var messages = self.source.run_due_checks(&self.documents)
        while message in &self.manifests.run_due_jobs(&self.documents) { messages.push(message.clone()) }
        return messages
    }

    mutating fun answer(id: str, method: str, body: str, messages: &var List<String>): String {
        return when (self.phase) {
            Starting => {
                if method != "initialize" {
                    return id.error_reply(ErrorCode.ServerNotInitialized, "the client has not sent initialize")
                }
                self.phase = Phase.Running
                id.result_reply(self.initialize(body).as_str())
            }
            Running => {
                if method == "shutdown" {
                    self.phase = Phase.ShuttingDown
                    return id.result_reply("null")
                }
                if method == "initialize" {
                    return id.error_reply(ErrorCode.InvalidRequest, "initialize was already sent")
                }
                if method == "workspace/executeCommand" {
                    self.manifests.execute(body, messages)
                    return id.result_reply("null")
                }
                val reply = self.request(id, method, body, messages)
                if reply.is_none() { return id.error_reply(ErrorCode.MethodNotFound, "no handler for ${method}") }
                reply ?: String.from("")
            }
            ShuttingDown => id.error_reply(ErrorCode.InvalidRequest, "the server is shutting down")
        }
    }

    /// Remembers the workspace and the position encoding, and names what
    /// the server can do.
    mutating fun initialize(body: str): String {
        val root_uri = body.string_at("params.rootUri") ?: ""
        val root = root_uri.as_str().file_path() ?: body.string_at("params.rootPath") ?: ""
        var utf8 = false
        while encoding in &body.strings_at("params.capabilities.general.positionEncodings") {
            if encoding.as_str() == "utf-8" { utf8 = true }
        }
        self.source.configure(root.as_str(), utf8)
        val inlay_refresh = body.bool_at("params.capabilities.workspace.inlayHint.refreshSupport") ?: false
        self.manifests.configure(utf8, inlay_refresh)
        return capabilities(utf8)
    }

    mutating fun notified(method: str, body: str, messages: &var List<String>): void {
        if self.phase != Phase.Running { return }
        when method {
            "textDocument/didOpen" => {
                val text = body.string_at("params.textDocument.text") ?: return
                self.edited(body, text.as_str(), messages)
            }
            "textDocument/didChange" => {
                val text = last_change_text(body) ?: return
                self.edited(body, text.as_str(), messages)
            }
            "textDocument/didSave" => {
                val uri = body.string_at("params.textDocument.uri") ?: return
                val path = uri.as_str().file_path() ?: return
                val text = self.documents.text_of(path.as_str())
                self.manifests.saved(path.as_str(), text.as_str(), messages)
            }
            "textDocument/didClose" => {
                val uri = body.string_at("params.textDocument.uri") ?: return
                val path = self.documents.path_of(uri.as_str()) ?: return
                self.documents.close(uri.as_str())
                if path.as_str().is_manifest() {
                    self.manifests.closed(path.as_str(), messages)
                } else {
                    self.source.closed(path.as_str(), messages)
                }
            }
            _ => {}
        }
    }

    /// A document's new text, kept; a source file's is also staged with the
    /// compiler.
    mutating fun edited(body: str, text: str, messages: &var List<String>): void {
        val uri = body.string_at("params.textDocument.uri") ?: return
        val path = uri.as_str().file_path() ?: return
        self.documents.open(uri.as_str(), path.as_str(), text)
        if path.as_str().is_manifest() {
            self.manifests.edited(path.as_str(), text, messages)
        } else {
            self.source.edited(path.as_str(), text, messages)
        }
    }
}

/// The text of a full-document change: the last entry of `contentChanges`.
fun last_change_text(body: str): String? {
    var reader = body.value_at("params.contentChanges") ?: return null
    if !reader.begin_array() { return null }
    var text: String? = null
    while reader.array_has_next() {
        if !reader.begin_object() { return null }
        while reader.object_has_next() {
            val key = reader.read_key()
            if key.as_str() == "text" { text = Option.Some(reader.read_string()) } else { reader.skip_value() }
        }
    }
    return text
}
