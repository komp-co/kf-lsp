import core.assert.assert_eq
import komp_lsp.protocol.*

fun inlays_answer(): String {
    return String.from("{\"id\":1,\"result\":{\"inlays\":[{\"byte_offset\":5,\"label\":\": int32\"},") +
        "{\"byte_offset\":13,\"label\":\": str\"}]}}"
}

@test
fun a_hint_is_a_type_at_its_position(): void {
    val expected = "[{\"position\":{\"line\":0,\"character\":5},\"label\":\": int32\",\"kind\":1}]"
    val hints = Answer.of(inlays_answer().as_str()).inlay_hints(&TextView.of("val x = 1\nval y = \"\"", true), 0, 0)
    assert_eq(hints.as_str(), expected, "only the first line's hint")
}

@test
fun hints_outside_the_range_are_left_out(): void {
    val hints = Answer.of(inlays_answer().as_str()).inlay_hints(&TextView.of("val x = 1\nval y = \"\"", true), 1, 1)
    assert_eq(hints.as_str().contains(": int32"), false, "the first line is not asked about")
}
