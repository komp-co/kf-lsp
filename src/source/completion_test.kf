import core.assert.assert_eq

@test
fun a_field_is_a_field(): void {
    val answer = String.from("{\"id\":1,\"result\":{\"receiver_type\":\"Point\",\"prefix\":\"\",") +
        "\"items\":[{\"label\":\"x\",\"kind\":\"field\",\"detail\":\"int32\"}]}}"
    val expected = "{\"isIncomplete\":false,\"items\":[{\"label\":\"x\",\"kind\":5,\"detail\":\"int32\"}]}"
    assert_eq(Answer.of(answer.as_str()).completion().as_str(), expected, "label, kind and detail")
}

@test
fun an_empty_detail_is_left_out(): void {
    val answer = "{\"id\":1,\"result\":{\"items\":[{\"label\":\"when\",\"kind\":\"keyword\",\"detail\":\"\"}]}}"
    val expected = "{\"isIncomplete\":false,\"items\":[{\"label\":\"when\",\"kind\":14}]}"
    assert_eq(Answer.of(answer).completion().as_str(), expected, "a keyword has no detail")
}

@test
fun an_error_answer_completes_nothing(): void {
    val answer = "{\"id\":1,\"error\":{\"code\":\"not_in_crate\",\"message\":\"x\"}}"
    assert_eq(Answer.of(answer).completion().as_str(), "{\"isIncomplete\":false,\"items\":[]}", "no items")
}
