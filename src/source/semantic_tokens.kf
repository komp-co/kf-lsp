// The compiler's `tokens` answer as LSP semantic tokens.

import json.reader.*
import json.writer.*
import komp_lsp.protocol.*

/// The legend's token types, as a JSON array: a token's type is its index
/// here, as `token_type` gives it.
pub fun semantic_token_legend(): String {
    return String.from("[\"variable\",\"function\",\"method\",\"property\",\"type\",\"enumMember\"]")
}

/// `textDocument/semanticTokens/full`'s result. Each token is five numbers:
/// its line and start relative to the token before it, its length, its
/// type and no modifiers. The compiler reports tokens in order and each on
/// one line, which the encoding needs.
pub fun Answer.semantic_tokens(view: &TextView): String {
    var writer = JsonWriter.object()
    writer.key("data")
    writer.begin_array()
    writer.write_token_data(self, view)
    writer.end_array()
    return writer.finish()
}

mutating fun JsonWriter.write_token_data(answer: &Answer, view: &TextView): void {
    var reader = answer.at("result.tokens") ?: return
    if !reader.begin_array() { return }
    var walker = PositionWalker.new()
    var line: uint64 = 0
    var character: uint64 = 0
    while reader.array_has_next() {
        if !reader.begin_object() {
            reader.skip_value()
            continue
        }
        var start: uint64 = 0
        var end: uint64 = 0
        var kind = String.from("")
        while reader.object_has_next() {
            val key = reader.read_key()
            when key.as_str() {
                "byte_start" => start = reader.read_uint64()
                "byte_end" => end = reader.read_uint64()
                "type" => kind = reader.read_string()
                _ => reader.skip_value()
            }
        }
        val type_index = token_type(kind.as_str())
        if type_index < 0 { continue }
        val from = walker.advance_to(view, start)
        val to = walker.advance_to(view, end)
        if to.line != from.line || to.character <= from.character { continue }
        if from.line < line || (from.line == line && from.character < character) { continue }
        self.write_uint64(from.line - line)
        self.write_uint64(if from.line == line { from.character - character } else { from.character })
        self.write_uint64(to.character - from.character)
        self.write_int64(type_index)
        self.write_int64(0)
        line = from.line
        character = from.character
    }
}

/// The legend index of the compiler's name for a token; -1 for a name the
/// legend does not hold.
fun token_type(name: str): int64 {
    return when name {
        "variable" => 0
        "function" => 1
        "method" => 2
        "field" => 3
        "type" => 4
        "enum_member" => 5
        _ => -1
    }
}
