// The compiler's `rename` answer as LSP's prepare-rename and rename
// results.

import alloc.list.*
import json.reader.*
import json.writer.*
import komp_lsp.protocol.*

/// `textDocument/prepareRename`'s result: the name under the cursor, or
/// `null` when it cannot be renamed.
pub fun Answer.prepare_rename(view: &TextView): String {
    if !(self.flag("result.ok") ?: false) { return String.from("null") }
    val start = self.int("result.range.byte_start") ?: return String.from("null")
    val end = self.int("result.range.byte_end") ?: return String.from("null")
    var writer = JsonWriter.new()
    writer.write_range(view, start as uint64, end as uint64)
    return writer.finish()
}

/// Why the compiler refused a rename; `null` when it did not.
pub fun Answer.rename_refusal(): String? {
    if self.flag("result.ok") ?: false { return null }
    val reason = self.string("result.error")
    if reason.is_some() { return reason }
    return Option.Some(String.from("this name cannot be renamed"))
}

/// `textDocument/rename`'s result: every edit, grouped by the file it is
/// in.
pub fun Answer.rename(new_name: str, files: &dyn FileText): String {
    val edits = self.rename_edits()
    var paths = List.new<String>()
    while edit in &edits {
        if !paths.contains(&edit.file) { paths.push(edit.file.clone()) }
    }
    var writer = JsonWriter.object()
    writer.key("changes")
    writer.begin_object()
    while file in &paths {
        val view = files.view_of(file.as_str())
        writer.key(file.as_str().file_uri().as_str())
        writer.begin_array()
        while edit in &edits {
            if edit.file.as_str() != file.as_str() { continue }
            writer.begin_object()
            writer.key("range")
            writer.write_range(&view, edit.start, edit.end)
            writer.field_string("newText", new_name)
            writer.end_object()
        }
        writer.end_array()
    }
    writer.end_object()
    return writer.finish()
}

fun Answer.rename_edits(): List<FileSpan> {
    var edits = List.new<FileSpan>()
    var reader = self.at("result.edits") ?: return edits
    if !reader.begin_array() { return edits }
    while reader.array_has_next() {
        val edit = read_file_span(&var reader) ?: continue
        edits.push(edit.clone())
    }
    return edits
}
