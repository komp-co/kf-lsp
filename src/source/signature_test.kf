import core.assert.assert_eq

@test
fun a_call_has_one_signature(): void {
    val answer = String.from("{\"id\":1,\"result\":{\"label\":\"add(a: int32, b: int32): int32\",") +
        "\"parameters\":[{\"label\":\"a: int32\"},{\"label\":\"b: int32\"}],\"active_parameter\":1}}"
    val expected = String.from("{\"signatures\":[{\"label\":\"add(a: int32, b: int32): int32\",") +
        "\"parameters\":[{\"label\":\"a: int32\"},{\"label\":\"b: int32\"}]}]," +
        "\"activeSignature\":0,\"activeParameter\":1}"
    assert_eq(Answer.of(answer.as_str()).signature_help().as_str(), expected.as_str(), "the callee, second parameter")
}

@test
fun no_call_is_null(): void {
    val answer = "{\"id\":1,\"result\":{\"label\":null,\"parameters\":[],\"active_parameter\":0}}"
    assert_eq(Answer.of(answer).signature_help().as_str(), "null", "no signature help")
}
