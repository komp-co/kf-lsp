import core.assert.assert_eq

fun references_answer(): String {
    return String.from("{\"id\":1,\"result\":{") +
        "\"declaration\":{\"file\":\"/w/a.kf\",\"byte_start\":4,\"byte_end\":7}," +
        "\"references\":[{\"file\":\"/w/b.kf\",\"byte_start\":0,\"byte_end\":3}]}}"
}

@test
fun a_definition_is_the_declaration(): void {
    val texts = FixedText { text: String.from("fun add"), utf8: true }
    val expected = String.from("{\"uri\":\"file:///w/a.kf\",") +
        "\"range\":{\"start\":{\"line\":0,\"character\":4},\"end\":{\"line\":0,\"character\":7}}}"
    val found = Answer.of(references_answer().as_str()).definition(&texts)
    assert_eq(found.as_str(), expected.as_str(), "where it is declared")
}

@test
fun no_declaration_is_no_definition(): void {
    val texts = FixedText { text: String.from(""), utf8: true }
    val answer = "{\"id\":1,\"result\":{\"declaration\":null,\"references\":[]}}"
    assert_eq(Answer.of(answer).definition(&texts).as_str(), "null", "nothing to go to")
}

@test
fun references_are_the_uses(): void {
    val texts = FixedText { text: String.from("add"), utf8: true }
    val found = Answer.of(references_answer().as_str()).references(false, &texts)
    assert_eq(found.as_str().contains("file:///w/a.kf"), false, "the declaration is not a use")
}

@test
fun references_can_lead_with_the_declaration(): void {
    val texts = FixedText { text: String.from("fun add"), utf8: true }
    val found = Answer.of(references_answer().as_str()).references(true, &texts)
    assert_eq(found.as_str().starts_with("[{\"uri\":\"file:///w/a.kf\""), true, "declaration first")
}

@test
fun implementations_are_locations(): void {
    val texts = FixedText { text: String.from("impl Loud for Point"), utf8: true }
    val answer = "{\"id\":1,\"result\":{\"implementations\":[{\"file\":\"/w/a.kf\",\"byte_start\":14,\"byte_end\":19}]}}"
    val found = Answer.of(answer).implementations(&texts)
    assert_eq(found.as_str().contains("\"character\":14"), true, "each impl, where it is")
}

@test
fun an_answer_without_implementations_is_empty(): void {
    val texts = FixedText { text: String.from(""), utf8: true }
    val answer = "{\"id\":1,\"error\":{\"code\":\"unknown_method\",\"message\":\"x\"}}"
    assert_eq(Answer.of(answer).implementations(&texts).as_str(), "[]", "an older compiler answers nothing")
}
