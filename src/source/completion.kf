// The compiler's `completion` answer as an LSP completion list.

import json.reader.*
import json.writer.*

/// `textDocument/completion`'s result. The list is complete: the client
/// filters it by what has been typed.
pub fun Answer.completion(): String {
    var writer = JsonWriter.object()
    writer.field_bool("isIncomplete", false)
    writer.key("items")
    writer.begin_array()
    writer.write_items(self)
    writer.end_array()
    return writer.finish()
}

mutating fun JsonWriter.write_items(answer: &Answer): void {
    var reader = answer.at("result.items") ?: return
    if !reader.begin_array() { return }
    while reader.array_has_next() {
        if !reader.begin_object() {
            reader.skip_value()
            continue
        }
        var label = String.from("")
        var kind = String.from("")
        var detail = String.from("")
        while reader.object_has_next() {
            val key = reader.read_key()
            when key.as_str() {
                "label" => label = reader.read_string()
                "kind" => kind = reader.read_string()
                "detail" => detail = reader.read_string()
                _ => reader.skip_value()
            }
        }
        if label.is_empty() { continue }
        self.begin_object()
        self.field_string("label", label.as_str())
        self.field_int64("kind", completion_kind(kind.as_str()))
        if !detail.is_empty() { self.field_string("detail", detail.as_str()) }
        self.end_object()
    }
}

/// LSP numbers completion kinds; this maps the compiler's names onto them.
fun completion_kind(name: str): int64 {
    return when name {
        "method" => 2
        "function" => 3
        "field" => 5
        "local" => 6
        "parameter" => 6
        "trait" => 8
        "enum" => 13
        "keyword" => 14
        "struct" => 22
        _ => 1
    }
}
