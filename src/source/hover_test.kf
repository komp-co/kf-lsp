import core.assert.assert_eq
import komp_lsp.protocol.*

@test
fun a_call_shows_its_signature_over_its_type(): void {
    val answer = String.from("{\"id\":1,\"result\":{\"type\":\"int32\",\"signature\":\"double(n: int32): int32\",") +
        "\"documentation\":null,\"byte_start\":2,\"byte_end\":4}}"
    val expected = String.from("{\"contents\":{\"kind\":\"markdown\",") +
        "\"value\":\"```kflat\\ndouble(n: int32): int32\\n```\"}," +
        "\"range\":{\"start\":{\"line\":0,\"character\":2},\"end\":{\"line\":0,\"character\":4}}}"
    val hover = Answer.of(answer.as_str()).hover(&TextView.of("abcdef", true))
    assert_eq(hover.as_str(), expected.as_str(), "the signature, over its span")
}

@test
fun documentation_follows_a_rule(): void {
    val answer = String.from("{\"id\":1,\"result\":{\"type\":null,\"signature\":\"f(): void\",") +
        "\"documentation\":\"Does it.\",\"byte_start\":0,\"byte_end\":0}}"
    val hover = Answer.of(answer.as_str()).hover(&TextView.of("", true))
    assert_eq(hover.as_str().contains("```\\n---\\nDoes it.\""), true, "code, a rule, then the docs")
}

@test
fun a_declaration_name_has_no_range(): void {
    val answer = String.from("{\"id\":1,\"result\":{\"type\":null,\"signature\":\"f(): void\",") +
        "\"documentation\":null,\"byte_start\":0,\"byte_end\":0}}"
    val hover = Answer.of(answer.as_str()).hover(&TextView.of("", true))
    assert_eq(hover.as_str().contains("\"range\""), false, "no span to highlight")
}

@test
fun nothing_to_show_is_null(): void {
    val answer = String.from("{\"id\":1,\"result\":{\"type\":null,\"signature\":null,") +
        "\"documentation\":null,\"byte_start\":0,\"byte_end\":0}}"
    assert_eq(Answer.of(answer.as_str()).hover(&TextView.of("", true)).as_str(), "null", "no hover")
}

@test
fun an_error_answer_is_null(): void {
    val answer = "{\"id\":1,\"error\":{\"code\":\"not_in_crate\",\"message\":\"x\"}}"
    assert_eq(Answer.of(answer).hover(&TextView.of("", true)).as_str(), "null", "no hover")
}
