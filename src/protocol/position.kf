// Where a byte offset falls, as LSP counts it: a zero-based line, and a
// character within it in the negotiated encoding.

import json.writer.*

pub struct Position {
    pub val line: uint64
    pub val character: uint64
}

/// A document's text, and whether the client counts characters in bytes
/// (`utf8`) or, LSP's default, in UTF-16 code units, where a character
/// outside the Basic Multilingual Plane counts two.
@derive(Clone)
pub struct TextView {
    pub val text: String
    pub val utf8: bool
}

impl TextView {
    pub static fun of(text: str, utf8: bool): TextView {
        return TextView { text: String.from(text), utf8: utf8 }
    }

    /// An offset past the end is the end.
    pub fun position_of(offset: uint64): Position {
        var walker = PositionWalker.new()
        return walker.advance_to(self, offset)
    }

    /// The byte offset of an LSP position; a character past its line's end
    /// is the line's end, and a line past the text's end is the end.
    pub fun offset_of(line: uint64, character: uint64): uint64 {
        val text = self.text.as_str()
        var at: uint64 = 0
        var current: uint64 = 0
        while current < line && at < text.byte_len() {
            if text.byte(at) == 10 { current = current + 1 }
            at = at + 1
        }
        var counted: uint64 = 0
        while counted < character && at < text.byte_len() {
            val byte = text.byte(at)
            if byte == 10 { return at }
            val width: uint64 = if byte < 128 { 1 } else if byte < 224 { 2 } else if byte < 240 { 3 } else { 4 }
            counted = counted + if self.utf8 { width } else if width == 4 { 2 } else { 1 }
            at = at + width
        }
        return at
    }

    /// The byte offset of a request's `params.position`.
    pub fun request_offset(body: str): uint64 {
        val line = body.int_at("params.position.line") ?: 0
        val character = body.int_at("params.position.character") ?: 0
        return self.offset_of(line as uint64, character as uint64)
    }
}

/// Positions of offsets in increasing order, each counted on from the last
/// rather than from the start of the text.
pub struct PositionWalker {
    var offset: uint64
    var line: uint64
    var character: uint64
}

impl PositionWalker {
    pub static fun new(): PositionWalker {
        return PositionWalker { offset: 0, line: 0, character: 0 }
    }

    /// The position of `offset`, which is not before the last one asked
    /// about; an earlier one answers the last position.
    pub mutating fun advance_to(view: &TextView, offset: uint64): Position {
        val text = view.text.as_str()
        val end = if offset < text.byte_len() { offset } else { text.byte_len() }
        while self.offset < end {
            val byte = text.byte(self.offset)
            if byte == 10 {
                self.line = self.line + 1
                self.character = 0
            } else if view.utf8 {
                self.character = self.character + 1
            } else if byte < 128 || (byte >= 192 && byte < 240) {
                self.character = self.character + 1
            } else if byte >= 240 {
                self.character = self.character + 2
            }
            self.offset = self.offset + 1
        }
        return Position { line: self.line, character: self.character }
    }
}

pub mutating fun JsonWriter.write_position(at: &Position): void {
    self.begin_object()
    self.field_uint64("line", at.line)
    self.field_uint64("character", at.character)
    self.end_object()
}

/// LSP's `{start, end}` for the bytes `start` to `end` of `view`.
pub mutating fun JsonWriter.write_range(view: &TextView, start: uint64, end: uint64): void {
    self.begin_object()
    self.key("start")
    self.write_position(&view.position_of(start))
    self.key("end")
    self.write_position(&view.position_of(end))
    self.end_object()
}
