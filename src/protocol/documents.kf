// The documents the editor has open, and their text as it last sent it.

import alloc.list.*
import std.fs.read_to_string

@derive(Clone)
pub struct Documents {
    var uris: List<String>
    var paths: List<String>
    var texts: List<String>
}

impl Documents {
    pub static fun new(): Documents {
        return Documents { uris: List.new<String>(), paths: List.new<String>(), texts: List.new<String>() }
    }

    /// Opening a document again replaces its text.
    pub mutating fun open(uri: str, path: str, text: str): void {
        when (self.index_of_uri(uri)) {
            Some(at) => self.texts.set(at, String.from(text))
            None => {
                self.uris.push(String.from(uri))
                self.paths.push(String.from(path))
                self.texts.push(String.from(text))
            }
        }
    }

    pub mutating fun close(uri: str): void {
        val at = self.index_of_uri(uri) ?: return
        val _uri = self.uris.remove(at)
        val _path = self.paths.remove(at)
        val _text = self.texts.remove(at)
    }

    pub fun path_of(uri: str): String? {
        val at = self.index_of_uri(uri) ?: return null
        return Option.Some(self.paths[at].clone())
    }

    /// The open text of the file at `path`; `null` when it is not open.
    pub fun text_at(path: str): String? {
        while i in 0..self.paths.size() {
            if self.paths[i].as_str() == path { return Option.Some(self.texts[i].clone()) }
        }
        return null
    }

    /// The file's open text, else what is on disk; "" when it cannot be
    /// read.
    pub fun text_of(path: str): String {
        when (self.text_at(path)) {
            Some(text) => return text.clone()
            None => {}
        }
        return when (read_to_string(path)) {
            Ok(text) => text.clone()
            Err(_error) => String.from("")
        }
    }

    pub fun view_of(path: str, utf8: bool): TextView {
        return TextView { text: self.text_of(path), utf8: utf8 }
    }

    fun index_of_uri(uri: str): uint64? {
        while i in 0..self.uris.size() {
            if self.uris[i].as_str() == uri { return Option.Some(i) }
        }
        return null
    }
}
