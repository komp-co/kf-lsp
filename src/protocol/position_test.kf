import core.assert.assert_eq

@test
fun the_start_is_line_zero_character_zero(): void {
    val at = TextView.of("abc", false).position_of(0)
    assert_eq(at.line == 0 && at.character == 0, true, "origin")
}

@test
fun a_newline_starts_the_next_line(): void {
    val at = TextView.of("ab\ncd", false).position_of(4)
    assert_eq(at.line == 1 && at.character == 1, true, "second line")
}

@test
fun a_two_byte_character_is_one_utf16_unit(): void {
    assert_eq(TextView.of("é=1", false).position_of(3).character, 2, "é then =")
}

@test
fun a_two_byte_character_is_two_utf8_units(): void {
    assert_eq(TextView.of("é=1", true).position_of(3).character, 3, "bytes")
}

@test
fun a_four_byte_character_is_two_utf16_units(): void {
    assert_eq(TextView.of("😀x", false).position_of(5).character, 3, "a surrogate pair, then x")
}

@test
fun an_offset_past_the_end_is_the_end(): void {
    assert_eq(TextView.of("ab", true).position_of(99).character, 2, "clamped")
}

@test
fun a_position_on_the_second_line_is_its_byte(): void {
    assert_eq(TextView.of("ab\ncd", false).offset_of(1, 1), 4, "c is 3, d is 4")
}

@test
fun a_utf16_position_skips_a_whole_character(): void {
    assert_eq(TextView.of("é=1", false).offset_of(0, 1), 2, "é is one unit, two bytes")
}

@test
fun a_surrogate_pair_is_two_units(): void {
    assert_eq(TextView.of("😀x", false).offset_of(0, 2), 4, "past the emoji")
}

@test
fun a_character_past_the_line_is_its_end(): void {
    assert_eq(TextView.of("ab\ncd", true).offset_of(0, 9), 2, "the newline")
}

@test
fun offsets_and_positions_agree(): void {
    val text = "fun é(): int32 {\n    return 😀\n}\n"
    val at = TextView.of(text, false).position_of(27)
    assert_eq(TextView.of(text, false).offset_of(at.line, at.character), 27, "a round trip")
}

@test
fun a_walker_counts_on_from_the_last_offset(): void {
    val view = TextView.of("ab\ncd", true)
    var walker = PositionWalker.new()
    val _first = walker.advance_to(&view, 1)
    val second = walker.advance_to(&view, 4)
    assert_eq(second.character, 1, "d's column on the second line")
}
