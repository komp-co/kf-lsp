import core.assert.assert_eq
import std.stream.pipe

@test
fun a_content_length_header_names_its_length(): void {
    assert_eq(content_length("Content-Length: 52") ?: 0, 52, "the length is read")
}

@test
fun a_header_name_ignores_case(): void {
    assert_eq(content_length("content-LENGTH:7") ?: 0, 7, "case does not matter")
}

@test
fun another_header_names_no_length(): void {
    assert_eq(content_length("Content-Type: application/vscode-jsonrpc").is_none(), true, "not a length")
}

@test
fun a_length_that_is_not_a_number_names_none(): void {
    assert_eq(content_length("Content-Length: 5x").is_none(), true, "not a number")
}

@test
fun a_framed_body_counts_bytes_not_characters(): void {
    assert_eq("\"é\"".framed().as_str(), "Content-Length: 4\r\n\r\n\"é\"", "é is two bytes")
}

@test
fun two_messages_in_one_read_come_out_one_at_a_time(): void {
    var ends = pipe().unwrap()
    val _written = ends.writer.write("Content-Length: 2\r\n\r\n{}Content-Length: 4\r\n\r\nnull")
    var reader = Reader.new(ends.reader.take())
    val _filled = reader.fill()
    var framer = Framer.new()
    val _first = framer.take(&var reader)
    assert_eq(framer.take(&var reader) ?: "", "null", "the second follows the first")
}

@test
fun a_body_still_arriving_is_not_taken(): void {
    var ends = pipe().unwrap()
    val _written = ends.writer.write("Content-Length: 10\r\n\r\n{\"a\"")
    var reader = Reader.new(ends.reader.take())
    val _filled = reader.fill()
    var framer = Framer.new()
    assert_eq(framer.take(&var reader).is_none(), true, "six bytes are missing")
}

@test
fun a_body_completed_later_is_taken_then(): void {
    var ends = pipe().unwrap()
    val _start = ends.writer.write("Content-Length: 7\r\n\r\n{\"a\"")
    var reader = Reader.new(ends.reader.take())
    val _filled = reader.fill()
    var framer = Framer.new()
    val _partial = framer.take(&var reader)
    val _rest = ends.writer.write(":1}")
    val _refilled = reader.fill()
    assert_eq(framer.take(&var reader) ?: "", "{\"a\":1}", "the framer kept its place")
}
