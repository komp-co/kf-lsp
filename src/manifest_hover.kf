// Hover in kf.toml and lint.toml: a package's versions and index, a lint's
// description and options, a group's lints.

import alloc.list.*
import json.writer.*

/// `textDocument/hover`'s result at byte `offset` of a manifest; `null` off
/// a row komp knows about.
mutating fun Server.manifest_hover(path: str, text: str, offset: uint64): String {
    val rows = manifest_rows(text)
    var found: ManifestRow? = null
    while row in &rows {
        if row.key_start <= offset && offset <= row.value_end { found = Option.Some(row.clone()) }
    }
    val row = found ?: return String.from("null")
    val dir = parent_dir(path)
    var markdown = String.from("")
    if path.ends_with("/lint.toml") || row.table.as_str() == "lint" {
        markdown = self.lint_hover(dir.as_str(), &row)
    } else if row.table.as_str() == "dependencies" || row.table.as_str() == "tools" {
        markdown = self.package_hover(dir.as_str(), &row)
    }
    if markdown.is_empty() { return String.from("null") }
    var writer = JsonWriter.object()
    writer.field_raw("contents", markdown_json(markdown.as_str()).as_str())
    writer.key("range")
    writer.write_range(text, row.key_start, row.key_end, self.utf8)
    return writer.finish()
}

mutating fun Server.package_hover(dir: str, row: &ManifestRow): String {
    val rows = self.manifests.outdated(self.komp.as_str(), dir)
    val _catalog = self.manifests.catalog(self.komp.as_str())
    var out = "**${row.key}**"
    val package = self.manifests.catalog_entry(row.key.as_str())
    when (package) {
        Some(entry) => if !entry.description.is_empty() { out.append("\n\n${entry.description}".as_str()) }
        None => {}
    }
    var known = package.is_some()
    while fact in &rows {
        if fact.section.as_str() != row.table.as_str() || fact.name.as_str() != row.key.as_str() { continue }
        known = true
        out.append("\n\n".as_str())
        if !fact.error.is_empty() {
            out.append(fact.error.as_str())
            continue
        }
        out.append("- requirement `${fact.requirement}`\n".as_str())
        if !fact.locked.is_empty() { out.append("- locked ${fact.locked}\n".as_str()) }
        if !fact.allowed.is_empty() { out.append("- newest allowed ${fact.allowed}\n".as_str()) }
        if !fact.newest.is_empty() { out.append("- newest ${fact.newest}\n".as_str()) }
        out.append("- from ${fact.index}".as_str())
    }
    return if known { out } else { String.from("") }
}

mutating fun Server.lint_hover(dir: str, row: &ManifestRow): String {
    val facts = self.manifests.lints(self.komp.as_str(), dir)
    if row.table.as_str() == "groups" {
        var names = List.new<String>()
        while lint in &facts.lints {
            if lint.group.as_str() == row.key.as_str() || row.key.as_str() == "all" { names.push(lint.name.clone()) }
        }
        if names.is_empty() { return String.from("") }
        return "**${row.key}**: ${names.join(", ")}"
    }
    val lint = facts.lint_named(row.key.as_str()) ?: return String.from("")
    return "**${lint.name}** (${lint.group})\n\n${lint_markdown(&lint)}"
}
