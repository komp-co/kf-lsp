// The compiler's `references` answer as LSP locations: where a name is
// declared, and where it is used.

import alloc.list.*
import json.reader.*
import json.writer.*

/// A span of bytes in a file, as the compiler reports one.
@derive(Clone)
struct FileSpan {
    val file: String
    val start: uint64
    val end: uint64
}

/// `textDocument/definition`'s result: the declaration's location, or
/// `null` when the answer names none.
pub fun lsp_definition(answer: str, text_of: &dyn FileText, utf8: bool): String {
    val declaration = span_at(answer, "result.declaration") ?: return String.from("null")
    var writer = JsonWriter.new()
    writer.write_location(&declaration, text_of, utf8)
    return writer.finish()
}

/// `textDocument/references`' result: every use, preceded by the
/// declaration when the client asks for it too.
pub fun lsp_references(answer: str, with_declaration: bool, text_of: &dyn FileText, utf8: bool): String {
    var writer = JsonWriter.new()
    writer.begin_array()
    if with_declaration {
        val declaration = span_at(answer, "result.declaration")
        if declaration.is_some() { writer.write_location(&declaration.unwrap(), text_of, utf8) }
    }
    writer.write_uses(answer, text_of, utf8)
    writer.end_array()
    return writer.finish()
}

/// The span `path` leads to in `answer`.
fun span_at(answer: str, path: str): FileSpan? {
    var reader = value_at(answer, path) ?: return null
    return read_file_span(&var reader)
}

mutating fun JsonWriter.write_uses(answer: str, text_of: &dyn FileText, utf8: bool): void {
    var reader = value_at(answer, "result.references") ?: return
    if !reader.begin_array() { return }
    while reader.array_has_next() {
        val use = read_file_span(&var reader) ?: continue
        self.write_location(&use, text_of, utf8)
    }
}

/// The `{"file", "byte_start", "byte_end"}` object the reader stands at;
/// `null`, with the value passed over, for anything else.
fun read_file_span(reader: &var JsonReader): FileSpan? {
    if reader.take_null() { return null }
    if !reader.begin_object() {
        reader.skip_value()
        return null
    }
    var file = String.from("")
    var start: uint64 = 0
    var end: uint64 = 0
    while reader.object_has_next() {
        val key = reader.read_key()
        when key.as_str() {
            "file" => file = reader.read_string()
            "byte_start" => start = reader.read_uint64()
            "byte_end" => end = reader.read_uint64()
            _ => reader.skip_value()
        }
    }
    if file.is_empty() { return null }
    return Option.Some(FileSpan { file: file, start: start, end: end })
}

mutating fun JsonWriter.write_location(span: &FileSpan, text_of: &dyn FileText, utf8: bool): void {
    val text = text_of.text_of(span.file.as_str())
    self.begin_object()
    self.field_string("uri", path_to_uri(span.file.as_str()).as_str())
    self.key("range")
    self.write_range(text.as_str(), span.start, span.end, utf8)
    self.end_object()
}
