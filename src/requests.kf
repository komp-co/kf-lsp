// Which side answers a request about a document: kf.toml and lint.toml are
// answered from what komp reports, every other file by the compiler.

import alloc.list.*
import komp_lsp.manifest.*
import komp_lsp.protocol.*
import komp_lsp.source.*

/// The reply to a request about a document; `null` for a method that is
/// not one. A file neither side can answer about gets an empty result.
mutating fun Server.request(id: str, method: str, body: str, messages: &var List<String>): String? {
    val empty = when method {
        "textDocument/documentSymbol" => "[]"
        "textDocument/foldingRange" => "[]"
        "textDocument/selectionRange" => "[]"
        "textDocument/hover" => "null"
        "textDocument/definition" => "null"
        "textDocument/references" => "[]"
        "textDocument/signatureHelp" => "null"
        "textDocument/completion" => "[]"
        "textDocument/inlayHint" => "[]"
        "textDocument/semanticTokens/full" => "{\"data\":[]}"
        "textDocument/prepareRename" => "null"
        "textDocument/rename" => "null"
        "textDocument/codeAction" => "[]"
        "textDocument/codeLens" => "[]"
        "textDocument/formatting" => "[]"
        _ => ""
    }
    if empty.is_empty() { return null }
    val uri = body.string_at("params.textDocument.uri") ?: return Option.Some(id.result_reply(empty))
    val path = uri.as_str().file_path() ?: return Option.Some(id.result_reply(empty))
    if path.as_str().is_manifest() {
        val text = self.documents.text_of(path.as_str())
        val result = self.manifests.request(method, body, path.as_str(), text.as_str(), empty)
        return Option.Some(id.result_reply(result.as_str()))
    }
    return Option.Some(self.source.request(id, method, body, path.as_str(), empty, &self.documents, messages))
}
