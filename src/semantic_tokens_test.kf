import core.assert.assert_eq

@test
fun tokens_are_relative_to_the_one_before(): void {
    val answer = String.from("{\"id\":1,\"result\":{\"tokens\":[") +
        "{\"byte_start\":4,\"byte_end\":8,\"type\":\"function\"}," +
        "{\"byte_start\":15,\"byte_end\":16,\"type\":\"variable\"}," +
        "{\"byte_start\":23,\"byte_end\":24,\"type\":\"field\"}]}}"
    val text = "fun main() {\n  x.y = x.z\n}"
    val expected = "{\"data\":[0,4,4,1,0,1,2,1,0,0,0,8,1,3,0]}"
    assert_eq(lsp_semantic_tokens(answer.as_str(), text, true).as_str(), expected, "line and start deltas")
}

@test
fun an_unknown_role_is_left_out(): void {
    val answer = "{\"id\":1,\"result\":{\"tokens\":[{\"byte_start\":0,\"byte_end\":1,\"type\":\"macro\"}]}}"
    assert_eq(lsp_semantic_tokens(answer, "a", true).as_str(), "{\"data\":[]}", "the legend has no macro")
}
