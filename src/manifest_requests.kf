// The files komp reads beside the source, kf.toml and lint.toml, answered
// from what komp reports rather than by the compiler.

/// Whether `path` is a kf.toml or a lint.toml.
pub fun is_manifest(path: str): bool {
    return path.ends_with("/kf.toml") || path.ends_with("/lint.toml")
}

/// The directory holding `path`.
fun parent_dir(path: str): String {
    var at = path.byte_len()
    while at > 0 && path.byte(at - 1) != 47 { at = at - 1 }
    if at == 0 { return String.from(".") }
    return path.substring(0, at - 1)
}

/// The reply to `method` about a manifest; `empty` for one it does not answer.
mutating fun Server.manifest_request(method: str, body: str, path: str, empty: str): String {
    val text = self.text_for(path)
    val offset = self.offset_at(body, text.as_str())
    if method == "textDocument/completion" { return self.manifest_completion(path, text.as_str(), offset) }
    if method == "textDocument/hover" { return self.manifest_hover(path, text.as_str(), offset) }
    if method != "textDocument/inlayHint" { return String.from(empty) }
    val first = int_at(body, "params.range.start.line") ?: 0
    val last = int_at(body, "params.range.end.line") ?: 9223372036854775807
    return self.manifest_inlays(path, text.as_str(), first as uint64, last as uint64)
}

/// A saved kf.toml, kf.lock or lint.toml changes what komp reports about
/// its project.
mutating fun Server.saved(path: str): void {
    val known = path.ends_with("/kf.toml") || path.ends_with("/kf.lock") || path.ends_with("/lint.toml")
    if known { self.manifests.forget(parent_dir(path).as_str()) }
}
