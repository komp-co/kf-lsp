import core.assert.assert_eq

@test
fun the_start_is_line_zero_character_zero(): void {
    val at = position_of("abc", 0, false)
    assert_eq(at.line == 0 && at.character == 0, true, "origin")
}

@test
fun a_newline_starts_the_next_line(): void {
    val at = position_of("ab\ncd", 4, false)
    assert_eq(at.line == 1 && at.character == 1, true, "second line")
}

@test
fun a_two_byte_character_is_one_utf16_unit(): void {
    assert_eq(position_of("é=1", 3, false).character, 2, "é then =")
}

@test
fun a_two_byte_character_is_two_utf8_units(): void {
    assert_eq(position_of("é=1", 3, true).character, 3, "bytes")
}

@test
fun a_four_byte_character_is_two_utf16_units(): void {
    assert_eq(position_of("😀x", 5, false).character, 3, "a surrogate pair, then x")
}

@test
fun an_offset_past_the_end_is_the_end(): void {
    assert_eq(position_of("ab", 99, true).character, 2, "clamped")
}
