// `file://` URIs, which LSP names documents by, and the paths the compiler
// names files by.

/// `null` for a URI that is not a local file.
pub fun uri_to_path(uri: str): String? {
    val scheme = "file://"
    if !uri.starts_with(scheme) { return null }
    var out = String.from("")
    var i = scheme.byte_len()
    while i < uri.byte_len() {
        val byte = uri.byte(i)
        if byte == 37 && i + 2 < uri.byte_len() {
            val high = hex_value(uri.byte(i + 1))
            val low = hex_value(uri.byte(i + 2))
            if high >= 0 && low >= 0 {
                out.push_byte((high * 16 + low) as uint8)
                i = i + 3
                continue
            }
        }
        out.push_byte(byte)
        i = i + 1
    }
    return Option.Some(out)
}

/// Every byte outside the unreserved set and `/` is percent-encoded.
pub fun path_to_uri(path: str): String {
    var out = String.from("file://")
    while i in 0..path.byte_len() {
        val byte = path.byte(i)
        if byte.is_unreserved() || byte == 47 {
            out.push_byte(byte)
        } else {
            out.append("%")
            out.push_byte(hex_digit(byte / 16))
            out.push_byte(hex_digit(byte % 16))
        }
    }
    return out
}

fun uint8.is_unreserved(): bool {
    val letter = (self >= 65 && self <= 90) || (self >= 97 && self <= 122)
    val digit = self >= 48 && self <= 57
    return letter || digit || self == 45 || self == 46 || self == 95 || self == 126
}

fun hex_value(byte: uint8): int32 {
    if byte >= 48 && byte <= 57 { return (byte - 48) as int32 }
    if byte >= 65 && byte <= 70 { return (byte - 55) as int32 }
    if byte >= 97 && byte <= 102 { return (byte - 87) as int32 }
    return -1
}

fun hex_digit(value: uint8): uint8 {
    return if value < 10 { value + 48 } else { value + 55 }
}
