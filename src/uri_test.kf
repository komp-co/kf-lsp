import core.assert.assert_eq

@test
fun a_file_uri_becomes_its_path(): void {
    assert_eq(uri_to_path("file:///home/me/app/src/main.kf") ?: "", "/home/me/app/src/main.kf", "plain")
}

@test
fun percent_escapes_are_decoded(): void {
    assert_eq(uri_to_path("file:///home/me/my%20app/a.kf") ?: "", "/home/me/my app/a.kf", "a space")
}

@test
fun another_scheme_is_no_path(): void {
    assert_eq(uri_to_path("untitled:Untitled-1").is_none(), true, "not a file")
}

@test
fun a_path_with_a_space_is_escaped(): void {
    assert_eq(path_to_uri("/home/me/my app/a.kf").as_str(), "file:///home/me/my%20app/a.kf", "encoded")
}

@test
fun a_path_survives_the_round_trip(): void {
    val path = "/tmp/ü#1/x.kf"
    assert_eq(uri_to_path(path_to_uri(path).as_str()) ?: "", path, "decode undoes encode")
}
