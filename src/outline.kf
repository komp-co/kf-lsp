// The compiler's outline answers — symbols, folding and selection ranges,
// in byte offsets — as LSP's shapes, in lines and characters.

import alloc.list.*
import json.reader.*
import json.writer.*

/// `textDocument/documentSymbol`'s result from a `symbols` answer: an array,
/// empty when the answer is not one.
pub fun lsp_symbols(answer: str, text: str, utf8: bool): String {
    var reader = value_at(answer, "result.symbols") ?: return String.from("[]")
    var writer = JsonWriter.new()
    writer.write_symbols(&var reader, text, utf8)
    if reader.has_error() { return String.from("[]") }
    return writer.finish()
}

mutating fun JsonWriter.write_symbols(reader: &var JsonReader, text: str, utf8: bool): void {
    self.begin_array()
    if reader.begin_array() {
        while reader.array_has_next() { self.write_symbol(reader, text, utf8) }
    }
    self.end_array()
}

/// A declaration's name token is not recorded, so the whole declaration is
/// its selection range too; LSP asks only that one hold the other.
mutating fun JsonWriter.write_symbol(reader: &var JsonReader, text: str, utf8: bool): void {
    var name = String.from("")
    var kind = String.from("")
    var detail = String.from("")
    var start: uint64 = 0
    var end: uint64 = 0
    var children = JsonWriter.new()
    var has_children = false
    if !reader.begin_object() { return }
    while reader.object_has_next() {
        val key = reader.read_key()
        when key.as_str() {
            "name" => name = reader.read_string()
            "kind" => kind = reader.read_string()
            "detail" => detail = reader.read_string()
            "byte_start" => start = reader.read_uint64()
            "byte_end" => end = reader.read_uint64()
            "children" => {
                children.write_symbols(reader, text, utf8)
                has_children = true
            }
            _ => reader.skip_value()
        }
    }
    self.begin_object()
    self.field_string("name", if name.is_empty() { "<anonymous>" } else { name.as_str() })
    if !detail.is_empty() { self.field_string("detail", detail.as_str()) }
    self.field_int64("kind", symbol_kind(kind.as_str()))
    self.key("range")
    self.write_range(text, start, end, utf8)
    self.key("selectionRange")
    self.write_range(text, start, end, utf8)
    val nested = if has_children { children.finish() } else { String.from("[]") }
    self.field_raw("children", nested.as_str())
    self.end_object()
}

/// LSP numbers symbol kinds; this maps KFlat's names onto them.
fun symbol_kind(name: str): int64 {
    return when name {
        "function" => 12
        "extern" => 12
        "method" => 6
        "struct" => 23
        "enum" => 10
        "variant" => 22
        "field" => 8
        "trait" => 11
        "type" => 26
        _ => 19
    }
}

/// `textDocument/foldingRange`'s result from a `folding` answer. A range
/// that starts and ends on one line has nothing to fold and is left out.
pub fun lsp_folding(answer: str, text: str, utf8: bool): String {
    val ranges = byte_ranges(answer)
    var writer = JsonWriter.new()
    writer.begin_array()
    while range in &ranges {
        val first = position_of(text, range.start, utf8).line
            val last = position_of(text, range.end, utf8).line
        if last > first {
            writer.begin_object()
            writer.field_uint64("startLine", first)
            writer.field_uint64("endLine", last)
            writer.field_string("kind", if range.kind.as_str() == "imports" { "imports" } else { "region" })
            writer.end_object()
        }
    }
    writer.end_array()
    return writer.finish()
}

/// One `SelectionRange` from a `selection` answer: innermost first in the
/// answer, while LSP links each range to its parent, so the chain is built
/// from the outside in. No range at all is an empty one at `offset`.
pub fun lsp_selection(answer: str, text: str, offset: uint64, utf8: bool): String {
    val ranges = byte_ranges(answer)
    if ranges.is_empty() {
        var empty = JsonWriter.new()
        empty.begin_object()
        empty.key("range")
        empty.write_range(text, offset, offset, utf8)
        empty.end_object()
        return empty.finish()
    }
    var chain = String.from("")
    var i = ranges.size()
    while i > 0 {
        i = i - 1
        var step = JsonWriter.new()
        step.begin_object()
        step.key("range")
        step.write_range(text, ranges[i].start, ranges[i].end, utf8)
        if !chain.is_empty() { step.field_raw("parent", chain.as_str()) }
        step.end_object()
        chain = step.finish()
    }
    return chain
}

/// The `ranges` of an answer; empty when it has none.
fun byte_ranges(answer: str): List<ByteRange> {
    var out = List.new<ByteRange>()
    var reader = value_at(answer, "result.ranges") ?: return out
    if reader.begin_array() {
        while reader.array_has_next() { out.push(read_range(&var reader)) }
    }
    return out
}

struct ByteRange {
    val start: uint64
    val end: uint64
    val kind: String
}

fun read_range(reader: &var JsonReader): ByteRange {
    var start: uint64 = 0
    var end: uint64 = 0
    var kind = String.from("")
    if reader.begin_object() {
        while reader.object_has_next() {
            val key = reader.read_key()
            when key.as_str() {
                "byte_start" => start = reader.read_uint64()
                "byte_end" => end = reader.read_uint64()
                "kind" => kind = reader.read_string()
                _ => reader.skip_value()
            }
        }
    }
    return ByteRange { start: start, end: end, kind: kind }
}

mutating fun JsonWriter.write_range(text: str, start: uint64, end: uint64, utf8: bool): void {
    self.begin_object()
    self.key("start")
    self.write_position(&position_of(text, start, utf8))
    self.key("end")
    self.write_position(&position_of(text, end, utf8))
    self.end_object()
}
