// The compiler's `rename` answer as LSP's prepare-rename and rename
// results.

import alloc.list.*
import json.reader.*
import json.writer.*

/// `textDocument/prepareRename`'s result: the name under the cursor, or
/// `null` when it cannot be renamed.
pub fun lsp_prepare_rename(answer: str, text: str, utf8: bool): String {
    if !(bool_at(answer, "result.ok") ?: false) { return String.from("null") }
    val start = int_at(answer, "result.range.byte_start") ?: return String.from("null")
    val end = int_at(answer, "result.range.byte_end") ?: return String.from("null")
    var writer = JsonWriter.new()
    writer.write_range(text, start as uint64, end as uint64, utf8)
    return writer.finish()
}

/// Why the compiler refused a rename; `null` when it did not.
pub fun rename_refusal(answer: str): String? {
    if bool_at(answer, "result.ok") ?: false { return null }
    val reason = string_at(answer, "result.error")
    if reason.is_some() { return reason }
    return Option.Some(String.from("this name cannot be renamed"))
}

/// `textDocument/rename`'s result: every edit, grouped by the file it is
/// in.
pub fun lsp_rename(answer: str, new_name: str, text_of: &dyn FileText, utf8: bool): String {
    val edits = rename_edits(answer)
    var files = List.new<String>()
    while edit in &edits {
        if !files.contains(&edit.file) { files.push(edit.file.clone()) }
    }
    var writer = JsonWriter.object()
    writer.key("changes")
    writer.begin_object()
    while file in &files {
        val text = text_of.text_of(file.as_str())
        writer.key(path_to_uri(file.as_str()).as_str())
        writer.begin_array()
        while edit in &edits {
            if edit.file.as_str() != file.as_str() { continue }
            writer.begin_object()
            writer.key("range")
            writer.write_range(text.as_str(), edit.start, edit.end, utf8)
            writer.field_string("newText", new_name)
            writer.end_object()
        }
        writer.end_array()
    }
    writer.end_object()
    return writer.finish()
}

fun rename_edits(answer: str): List<FileSpan> {
    var edits = List.new<FileSpan>()
    var reader = value_at(answer, "result.edits") ?: return edits
    if !reader.begin_array() { return edits }
    while reader.array_has_next() {
        val edit = read_file_span(&var reader) ?: continue
        edits.push(edit.clone())
    }
    return edits
}
