// The project as `komp metadata` describes it: where the compiler is, where
// the interfaces are, and each crate's root and what it loads.

import alloc.list.*
import json.reader.*
import json.writer.*
import alloc.path.Path
import std.fs.TempDir
import std.fs.read_to_string
import std.process.Command

@derive(Clone)
pub struct CrateEntry {
    pub val name: String
    pub val root: String
    pub val member: bool
    pub val loads: List<String>
    /// `name=level` rows.
    pub val lints: List<String>
    /// `name.key=value` rows.
    pub val lint_options: List<String>
}

@derive(Clone)
pub struct Project {
    pub val kflatc: String
    pub val target_dir: String
    pub val crates: List<CrateEntry>
}

/// Runs `komp metadata` on `root`; `null`, with `failure` saying why, when
/// there is no project.
pub fun load_project(komp: str, root: str, failure: &var String): Project? {
    val scratch = TempDir.new("kflat-lsp")
    val output = "${scratch.path().as_str()}/metadata.json"
    var command = Command.new(komp)
    command.arg("metadata")
    command.arg(root)
    command.stdout_to(Path.new(output.as_str()))
    val status = command.status()
    if !status.success() {
        *failure = "`${komp} metadata ${root}` exited ${status.exit_code()}"
        return null
    }
    val text = when (read_to_string(output.as_str())) {
        Ok(read) => read.clone()
        Err(error) => String.from("")
    }
    val project = parse_metadata(text.trim().as_str())
    if project.is_none() { *failure = "`${komp} metadata` printed no project" }
    return project
}

/// `null` when `text` is not `komp metadata`'s object.
pub fun parse_metadata(text: str): Project? {
    var reader = JsonReader.new(text)
    if !reader.begin_object() { return null }
    var kflatc = String.from("")
    var target_dir = String.from("")
    var crates = List.new<CrateEntry>()
    while reader.object_has_next() {
        val key = reader.read_key()
        when key.as_str() {
            "kflatc" => kflatc = reader.read_string()
            "target_dir" => target_dir = reader.read_string()
            "crates" => {
                if !reader.begin_array() { return null }
                while reader.array_has_next() { crates.push(read_crate(&var reader)) }
            }
            _ => reader.skip_value()
        }
    }
    if reader.has_error() || kflatc.is_empty() || target_dir.is_empty() { return null }
    return Option.Some(Project { kflatc: kflatc, target_dir: target_dir, crates: crates })
}

fun read_crate(reader: &var JsonReader): CrateEntry {
    var name = String.from("")
    var root = String.from("")
    var member = false
    var loads = List.new<String>()
    var lints = List.new<String>()
    var lint_options = List.new<String>()
    if reader.begin_object() {
        while reader.object_has_next() {
            val key = reader.read_key()
            when key.as_str() {
                "name" => name = reader.read_string()
                "root" => root = reader.read_string()
                "member" => member = reader.read_bool()
                "loads" => loads = read_strings(reader)
                "lints" => lints = read_lint_rows(reader)
                "lint_options" => lint_options = read_option_rows(reader)
                _ => reader.skip_value()
            }
        }
    }
    return CrateEntry { name: name, root: root, member: member, loads: loads, lints: lints, lint_options: lint_options }
}

/// `{"name", "level"}` objects, as `komp metadata` lists them, or `name=level` strings.
fun read_lint_rows(reader: &var JsonReader): List<String> {
    var out = List.new<String>()
    if !reader.begin_array() { return out }
    while reader.array_has_next() {
        if reader.peek_kind() != JsonKind.Object {
            out.push(reader.read_string())
            continue
        }
        val fields = read_string_fields(reader)
        out.push("${fields.name}=${fields.level}")
    }
    return out
}

/// `{"name", "key", "value"}` objects as `name.key=value` rows.
fun read_option_rows(reader: &var JsonReader): List<String> {
    var out = List.new<String>()
    if !reader.begin_array() { return out }
    while reader.array_has_next() {
        val fields = read_string_fields(reader)
        out.push("${fields.name}.${fields.key}=${fields.value}")
    }
    return out
}

struct LintFields {
    var name: String
    var level: String
    var key: String
    var value: String
}

fun read_string_fields(reader: &var JsonReader): LintFields {
    var fields = LintFields { name: String.from(""), level: String.from(""), key: String.from(""), value: String.from("") }
    if !reader.begin_object() { return fields }
    while reader.object_has_next() {
        val field = reader.read_key()
        when field.as_str() {
            "name" => fields.name = reader.read_string()
            "level" => fields.level = reader.read_string()
            "key" => fields.key = reader.read_string()
            "value" => fields.value = reader.read_string()
            _ => reader.skip_value()
        }
    }
    return fields
}

fun read_strings(reader: &var JsonReader): List<String> {
    var out = List.new<String>()
    if !reader.begin_array() { return out }
    while reader.array_has_next() { out.push(reader.read_string()) }
    return out
}

impl Project {
    /// The member crate whose root holds `path`, the deepest when roots
    /// nest; `null` for a file in no member.
    pub fun crate_for(path: str): CrateEntry? {
        var best: CrateEntry? = null
        var best_length: uint64 = 0
        while entry in &self.crates {
            val prefix = "${entry.root}/"
            if entry.member && path.starts_with(prefix.as_str()) && prefix.byte_len() > best_length {
                best = Option.Some(entry.clone())
                best_length = prefix.byte_len()
            }
        }
        return best
    }

    pub fun crate_named(name: str): CrateEntry? {
        while entry in &self.crates {
            if entry.name.as_str() == name { return Option.Some(entry.clone()) }
        }
        return null
    }

    /// The crates a typed request names for `entry`: what it loads, then
    /// itself, as `{"name", "root"}` objects.
    pub fun typed_crates(entry: &CrateEntry): String {
        var writer = JsonWriter.array()
        while name in &entry.loads {
            val loaded = self.crate_named(name.as_str()) ?: continue
            writer.write_crate_source(&loaded)
        }
        writer.write_crate_source(entry)
        return writer.finish()
    }

    /// `kflatc serve`'s `check` params for `entry`.
    pub fun check_params(entry: &CrateEntry): String {
        var writer = JsonWriter.object()
        writer.field_string("target_dir", self.target_dir.as_str())
        writer.key("crate")
        writer.begin_object()
        writer.field_string("name", entry.name.as_str())
        writer.field_string("root", entry.root.as_str())
        writer.key("loads")
        writer.begin_array()
        while load in &entry.loads { writer.write_string(load.as_str()) }
        writer.end_array()
        writer.key("lints")
        writer.begin_array()
        while lint in &entry.lints { writer.write_string(lint.as_str()) }
        writer.end_array()
        writer.key("lint_options")
        writer.begin_array()
        while row in &entry.lint_options { writer.write_option_row(row.as_str()) }
        writer.end_array()
        writer.end_object()
        return writer.finish()
    }
}

mutating fun JsonWriter.write_crate_source(entry: &CrateEntry): void {
    self.begin_object()
    self.field_string("name", entry.name.as_str())
    self.field_string("root", entry.root.as_str())
    self.end_object()
}

/// A `name.key=value` row as the `{"name", "key", "value"}` object it was read from.
mutating fun JsonWriter.write_option_row(row: str): void {
    val dot = row.index_of(".") ?: return
    val eq = row.index_of("=") ?: return
    self.begin_object()
    self.field_string("name", row.substring(0, dot).as_str())
    self.field_string("key", row.substring(dot + 1, eq).as_str())
    self.field_string("value", row.substring(eq + 1, row.byte_len()).as_str())
    self.end_object()
}
