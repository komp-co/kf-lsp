import alloc.list.*
import core.assert.assert_eq

@test
fun a_named_index_resolves_through_indexes(): void {
    val text = "[dependencies]\nyaml = { version = \"0.3\", index = \"work\" }\n\n[indexes]\nwork = \"file:///w\"\n"
    val rows = manifest_rows(text)
    assert_eq(index_url_for(text, &rows, "dependencies", "yaml").as_str(), "file:///w", "the [indexes] row")
}

@test
fun a_plain_requirement_uses_the_default_index(): void {
    val text = "[dependencies]\njson = \"0.1\"\n"
    val rows = manifest_rows(text)
    assert_eq(index_url_for(text, &rows, "dependencies", "json").is_empty(), true, "no --index")
}

@test
fun a_value_outside_quotes_is_inserted_quoted(): void {
    assert_eq(value("0.2.0", "", "", true).insert.as_str(), "\"0.2.0\"", "quotes added")
}

@test
fun sort_keys_keep_the_given_order(): void {
    assert_eq("${sort_key(7)} ${sort_key(12)}".as_str(), "0007 0012", "zero-padded")
}

@test
fun a_lint_option_is_described(): void {
    var options = List.new<LintOption>()
    options.push(LintOption { key: String.from("max"), value: 7, default_value: 7, description: String.from("most") })
    val lint = LintFact {
        name: String.from("too_many_parameters"), group: String.from("complexity"), level: String.from("warn"),
        default_level: String.from("warn"), description: String.from("many"), options: options
    }
    assert_eq(lint_markdown(&lint).as_str(), "many\n\n`max = 7`: most", "the option under the description")
}

@test
fun kf_toml_and_lint_toml_are_manifests(): void {
    assert_eq(is_manifest("/p/kf.toml") && is_manifest("/p/lint.toml") && !is_manifest("/p/kf.lock"), true, "both")
}

@test
fun a_manifest_directory_is_its_parent(): void {
    assert_eq(parent_dir("/p/app/kf.toml").as_str(), "/p/app", "the project")
}
